+
+test "Verify width calibration: round uploads end at the last bucket ancestor and reject an oversized verify schedule" {
+    const R = q.round;
+    var storage: [R.bytes]u8 align(16) = @splat(0xa5);
+    try std.testing.expectEqual(R.most_verify, R.steps(&storage).len);
+    try std.testing.expectEqual(R.src_at, R.textBytes(R.max_rows));
+    for ([_]usize{ 1, 4, 16, 128, 129, 4096 }) |rows| {
+        const end = R.textBytes(rows);
+        const ancestors = R.ancestors(&storage)[0..rows];
+        try std.testing.expectEqual(@intFromPtr(storage[end..].ptr), @intFromPtr(ancestors.ptr) + std.mem.sliceAsBytes(ancestors).len);
+    }
+    const parts = [_]q.engine.Part{ .{ .cache = undefined, .rows = 64 }, .{ .cache = undefined, .rows = 64 }, .{ .cache = undefined, .rows = 1 } };
+    try std.testing.expectError(error.InvalidQwenSegments, R.build(&storage, &parts, true));
+    try std.testing.expectEqual(@as(u8, 0xa5), storage[R.rules_at]);
+    try std.testing.expectEqual(@as(usize, 1), try R.build(&storage, &.{.{ .cache = undefined, .rows = R.max_rows }}, false));
+}
